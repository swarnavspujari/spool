{
  "name": "spool",
  "version": "1.1.0",
  "private": true,
  "description": "Browser extension: screenshot a whole scrolling chat or page, as one tall image plus screenshots sized for your AI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "check": "npm run policy && npm run typecheck && npm test",
    "policy": "node scripts/check-policy.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "node --test --test-reporter=spec \"test/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
